# Use lightweight Python version
FROM python:3.9-slim

WORKDIR /app

# [SECURITY FIX] Force update of OpenSSL and system libraries to patch CVE-2025-15467
RUN apt-get update && \
    apt-get install -y --only-upgrade openssl libssl3 && \
    apt-get upgrade -y && \
    apt-get clean

# Copy requirements file
COPY requirements.txt .

# Install dependencies automatically without cache
RUN pip install --no-cache-dir -r requirements.txt

# Copy the analytics script
COPY analytics.py .

# [CHANGED] Run the script directly (with unbuffered output)
CMD ["python", "-u", "analytics.py"]