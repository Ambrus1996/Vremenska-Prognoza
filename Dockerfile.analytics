# 1. Use a lightweight Python version
FROM python:3.9-slim

# 2. Set the working directory
WORKDIR /app

# [SECURITY FIX] Update packages to patch OpenSSL CVE-2025-15467
# Trivy requires this update to clear the Critical vulnerability
RUN apt-get update && apt-get upgrade -y && apt-get clean

# 3. Copy the list of requirements into the container
COPY requirements.txt .

# 4. Install dependencies automatically
# --no-cache-dir means it won't save installation cache (saves space)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy our script inside
COPY analytics.py .

# 6. Command to keep the container running (so you can enter and test)
# Later we will change this to run the script automatically
CMD ["tail", "-f", "/dev/null"]